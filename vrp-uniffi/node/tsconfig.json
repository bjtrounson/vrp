{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "rootDir": "generated",
    "outDir": "dist",
    "types": ["node"]
  },
  "include": ["generated/**/*.ts"]
}
